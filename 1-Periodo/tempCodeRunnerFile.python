import cv2
import easyocr
import numpy as np

def clean_watermarks(image_path, output_path):
    # 1. Carregar a imagem
    img = cv2.imread(image_path)
    mask = np.zeros(img.shape[:2], dtype="uint8")
    
    # 2. Inicializar o OCR (pode ser configurado para GPU)
    reader = easyocr.Reader(['pt', 'en'])
    results = reader.readtext(image_path)

    # 3. Criar a máscara baseada na detecção de texto
    for (bbox, text, prob) in results:
        # Extrair coordenadas do polígono de detecção
        top_left = tuple(map(int, bbox[0]))
        bottom_right = tuple(map(int, bbox[2]))
        
        # Desenhar um retângulo branco na máscara (área a ser removida)
        cv2.rectangle(mask, top_left, bottom_right, 255, -1)

    # 4. Dilatar a máscara levemente para garantir que as bordas do texto sumam
    kernel = np.ones((5, 5), np.uint8)
    mask = cv2.dilate(mask, kernel, iterations=1)

    # 5. Aplicar Inpainting (Telea ou Navier-Stokes)
    # Para marcas complexas, aqui você chamaria um modelo de IA como o LaMa
    result = cv2.inpaint(img, mask, inpaintRadius=7, flags=cv2.INPAINT_TELEA)

    # Guardar o resultado
    cv2.imwrite(output_path, result)
    print(f"Processamento concluído: {output_path}")

# Exemplo de uso:
# clean_watermarks('corrida.jpg', 'corrida_limpa.jpg')